{
  "name": "@uglyunicorn/pie",
  "version": "0.1.16",
  "description": "Schema-validated envelopes using HPKE",
  "keywords": [
    "schema",
    "envelope",
    "hpke",
    "valibot"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Ugly Unicorn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uglyunicorn-eh/pie.git"
  },
  "bugs": {
    "url": "https://github.com/uglyunicorn-eh/pie/issues"
  },
  "homepage": "https://github.com/uglyunicorn-eh/pie#readme",
  "scripts": {
    "build": "bun run scripts/build.ts && bun run build:types",
    "build:types": "tsc --project tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "default": "./dist/crypto/index.js"
    },
    "./valibot": {
      "types": "./dist/schema/valibot.d.ts",
      "default": "./dist/schema/valibot.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@valibot/to-json-schema": "^1.7.1",
    "prettier": "^3.9.5"
  },
  "peerDependencies": {
    "typescript": "^5.9.3",
    "valibot": "^1.2.0"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "hpke": "^1.1.3"
  }
}
